{
  "rules": {
    ".read": false,
    ".write": false,
    "items": {
      ".read": true,
      ".write": "auth != null && root.child('staff').child(auth.uid).val() === true"
    },
    "flavors": {
      ".read": true,
      ".write": "auth != null && root.child('staff').child(auth.uid).val() === true"
    },
    "staff": {
      ".read": false,
      ".write": false
    }
  }
}
